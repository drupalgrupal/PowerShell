[CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'Low')]
param(
    [Parameter(Mandatory = $true, Position = 0, ValueFromPipeline = $true, ValueFromPipelineByPropertyName = $true)]
    [ValidateNotNullOrEmpty()]
    [string[]]$ServerInstance,

    [Parameter(Mandatory = $false)]
    [ValidateNotNullOrEmpty()]
    [string]$OutputFolder = (Get-Location).Path,

    [Parameter(Mandatory = $false)]
    [ValidateNotNullOrEmpty()]
    [string]$FileBaseName = 'SQLInstanceMetadata',

    [Parameter(Mandatory = $false)]
    [System.Management.Automation.PSCredential]$SqlCredential
)

begin {
    $scriptStartTime = Get-Date

    if (-not (Test-Path -LiteralPath $OutputFolder)) {
        if ($PSCmdlet.ShouldProcess($OutputFolder, 'Create output folder')) {
            New-Item -ItemType Directory -Path $OutputFolder -Force | Out-Null
        }
    }

    Write-Verbose "Output folder: $OutputFolder"
    Write-Verbose "File base name: $FileBaseName"
    Write-Verbose "Script start time: $($scriptStartTime.ToString('yyyy-MM-dd HH:mm:ss'))"


    if (-not (Get-Module -Name SqlServer -ListAvailable)) {
        throw "The 'SqlServer' PowerShell module is not installed. Install-Module SqlServer -Scope CurrentUser"
    }

    Import-Module SqlServer -ErrorAction Stop
    Write-Verbose "SqlServer module loaded successfully"

    $allInfoRows = New-Object System.Collections.Generic.List[object]
    $allSettingsRows = New-Object System.Collections.Generic.List[object]
    $allConfigRows = New-Object System.Collections.Generic.List[object]
    $processedInstances = New-Object System.Collections.Generic.List[string]
    $failedInstances = New-Object System.Collections.Generic.List[string]
}

process {
    foreach ($instanceName in $ServerInstance) {
        Write-Verbose "Starting export for instance: $instanceName"

        try {
            if ($SqlCredential) {
                Write-Verbose "Connecting to $instanceName using SQL authentication"

                $srvConn = New-Object Microsoft.SqlServer.Management.Common.ServerConnection
                $srvConn.ServerInstance = $instanceName
                $srvConn.LoginSecure = $false
                $srvConn.Login = $SqlCredential.UserName
                $srvConn.SecurePassword = $SqlCredential.Password
                $instance = New-Object Microsoft.SqlServer.Management.Smo.Server($srvConn)
            }
            else {
                Write-Verbose "Connecting to $instanceName using Windows authentication"
                $instance = New-Object Microsoft.SqlServer.Management.Smo.Server $instanceName
            }

            $null = $instance.Information.Version
            Write-Verbose "Connected successfully to $instanceName"
        }
        catch {
            Write-Warning "Failed to connect to SQL Server instance '$instanceName'. $($_.Exception.Message)"
            $failedInstances.Add($instanceName)
            continue
        }

        $hostName = $instance.NetName
        $DT    = $instance.Databases["master"].ExecuteWithResults('SELECT LEFT(@@VERSION, CHARINDEX(CHAR(10), @@VERSION + CHAR(10)) - 1) AS VersionString;').Tables[0]
        $SQLVersionString = $dt.VersionString

        $DT    = $instance.Databases["master"].ExecuteWithResults('SELECT LEFT(@@VERSION, CHARINDEX(CHAR(10), @@VERSION + CHAR(10)) - 1) AS VersionString;').Tables[0]
        $SQLVersionString = $dt.VersionString

        $DT2   = $instance.Databases["master"].ExecuteWithResults('SELECT SERVERPROPERTY(''IsHadrEnabled'') [AlwaysOnStatus];').Tables[0]
        $AlwaysOnStatus = $dt2.AlwaysOnStatus

        switch ($AlwaysOnStatus) {
            $null { $AlwaysOn = 'Not Applicable' }
            0     { $AlwaysOn = 'Disabled' }
            1     { $AlwaysOn = 'Enabled' }
            default { $AlwaysOn = 'Unknown' }
        }


        try {
            $hostIp = [System.Net.Dns]::GetHostAddresses($hostName) |
                Where-Object { $_.AddressFamily -eq 'InterNetwork' } |
                Select-Object -First 1 -ExpandProperty IPAddressToString
        }
        catch {
            Write-Verbose "Unable to resolve IPv4 address for host '$hostName'"
            $hostIp = $null
        }

        try {
            $dbCount = $instance.Databases.Count
        }
        catch {
            Write-Verbose "Unable to retrieve database count for instance '$instanceName'"
            $dbCount = $null
        }

        Write-Verbose "Instance: $instanceName | Host: $hostName | IP: $hostIp | Databases: $dbCount"

        try {
            $infoProps = $instance.Information.Properties | Select-Object Name, Value
            $settingsProps = $instance.Settings.Properties | Select-Object Name, Value
            $configProps = $instance.Configuration.Properties |
                Select-Object DisplayName, Description, RunValue, ConfigValue
        }
        catch {
            Write-Warning "Failed to retrieve metadata from instance '$instanceName'. $($_.Exception.Message)"
            $failedInstances.Add($instanceName)
            continue
        }

        $infoHash = [ordered]@{
            ServerInstance    = $instanceName
            HostName          = $hostName
            IPAddress         = $hostIp
            SQLVersionString  = $SQLVersionString
            NumberOfDatabases = $dbCount
            AlwaysOnStatus    = $AlwaysOn
        }

        foreach ($p in $infoProps) {
            $name = $p.Name
            if (-not [string]::IsNullOrWhiteSpace($name) -and -not $infoHash.Contains($name)) {
                $infoHash[$name] = $p.Value
            }
        }

        $settingsHash = [ordered]@{
            ServerInstance    = $instanceName
            HostName          = $hostName
            IPAddress         = $hostIp
            SQLVersionString  = $SQLVersionString
            NumberOfDatabases = $dbCount
            AlwaysOnStatus    = $AlwaysOn
        }

        foreach ($p in $settingsProps) {
            $name = $p.Name
            if (-not [string]::IsNullOrWhiteSpace($name) -and -not $settingsHash.Contains($name)) {
                $settingsHash[$name] = $p.Value
            }
        }

        $configValueHash = [ordered]@{
            ServerInstance    = $instanceName
            HostName          = $hostName
            IPAddress         = $hostIp
            SQLVersionString  = $SQLVersionString
            NumberOfDatabases = $dbCount
            AlwaysOnStatus    = $AlwaysOn
            ValueType         = 'ConfigValue'
        }

        $runValueHash = [ordered]@{
            ServerInstance    = $instanceName
            HostName          = $hostName
            IPAddress         = $hostIp
            SQLVersionString  = $SQLVersionString
            NumberOfDatabases = $dbCount
            AlwaysOnStatus    = $AlwaysOn
            ValueType         = 'RunValue'
        }

        foreach ($c in $configProps) {
            $name = $c.DisplayName
            if (-not [string]::IsNullOrWhiteSpace($name)) {
                if (-not $configValueHash.Contains($name)) {
                    $configValueHash[$name] = $c.ConfigValue
                }

                if (-not $runValueHash.Contains($name)) {
                    $runValueHash[$name] = $c.RunValue
                }
            }
        }

        $allInfoRows.Add([PSCustomObject]$infoHash)
        $allSettingsRows.Add([PSCustomObject]$settingsHash)
        $allConfigRows.Add([PSCustomObject]$configValueHash)
        $allConfigRows.Add([PSCustomObject]$runValueHash)
        $processedInstances.Add($instanceName)
    }
}

end {
    $scriptEndTime = Get-Date
    $scriptDuration = $scriptEndTime - $scriptStartTime

    $infoCsvPath = Join-Path $OutputFolder "$FileBaseName`_Info.csv"
    $settingsCsvPath = Join-Path $OutputFolder "$FileBaseName`_Settings.csv"
    $configCsvPath = Join-Path $OutputFolder "$FileBaseName`_Config.csv"
    $readmePath = Join-Path $OutputFolder "$FileBaseName`_README.txt"

    $failedInstanceSection = if ($failedInstances.Count -gt 0) {
        ($failedInstances | Sort-Object | ForEach-Object { "- $_" }) -join [Environment]::NewLine
    }
    else {
        "- None"
    }

    $readmeContent = @"
SQL Server Instance Metadata Inventory
=====================================

This output set was generated by Export-InstanceMetadata.ps1.

Purpose
-------
These files provide an inventory of instance-level SQL Server metadata collected
from one or more SQL Server instances using PowerShell and SQL Server Management
Objects (SMO).

Output Files
------------
1. $FileBaseName`_Info.csv
   - Contains data collected from Server.Information
   - Includes properties such as version, edition, collation, operating system details,
     and other server identity information
   - One row per SQL Server instance

2. $FileBaseName`_Settings.csv
   - Contains data collected from Server.Settings
   - Includes instance-level settings exposed through SMO
   - One row per SQL Server instance

3. $FileBaseName`_Config.csv
   - Contains data collected from Server.Configuration
   - Includes configuration values similar to sp_configure
   - Two rows per SQL Server instance:
       * ValueType = ConfigValue
       * ValueType = RunValue

Common Columns
--------------
The following columns are added to all output files:
- ServerInstance: SQL Server instance name supplied to the script
- HostName: SQL Server host name reported by SMO
- IPAddress: First resolved IPv4 address for the host, if available
- SQLVersionString: SQL Server Version Name
- NumberOfDatabases: Count of databases visible on the instance
- AlwaysOnStatus: Whether SQL Server AlwaysOn Feature is enabled, if applicable

How Data Was Collected
----------------------
- The script uses the SqlServer PowerShell module
- SQL Server metadata is collected through SMO
- Authentication:
    * Windows Authentication by default
    * SQL Authentication if -SqlCredential is supplied
- The script connects to each SQL Server instance in the input list
- Metadata is collected and stored in memory
- Consolidated CSV files are written at the end of processing

Run Summary
-----------
- Script start time: $($scriptStartTime.ToString('yyyy-MM-dd HH:mm:ss'))
- Script end time:   $($scriptEndTime.ToString('yyyy-MM-dd HH:mm:ss'))
- Duration:          $($scriptDuration.ToString('hh\:mm\:ss'))
- Processed instances: $($processedInstances.Count)
- Failed instances:    $($failedInstances.Count)

Failed Instance Names
---------------------
$failedInstanceSection

Notes
-----
- This output is intended for instance inventory and configuration review
- It does not include database-level or object-level metadata
- If a connection fails for one instance, the script continues processing the others
- Missing values may occur if properties are not available or permissions are limited
"@

    try {
        if ($allInfoRows.Count -gt 0 -and $PSCmdlet.ShouldProcess($infoCsvPath, 'Export consolidated info CSV')) {
            $allInfoRows | Export-Csv -Path $infoCsvPath -NoTypeInformation -Encoding UTF8
        }

        if ($allSettingsRows.Count -gt 0 -and $PSCmdlet.ShouldProcess($settingsCsvPath, 'Export consolidated settings CSV')) {
            $allSettingsRows | Export-Csv -Path $settingsCsvPath -NoTypeInformation -Encoding UTF8
        }

        if ($allConfigRows.Count -gt 0 -and $PSCmdlet.ShouldProcess($configCsvPath, 'Export consolidated config CSV')) {
            $allConfigRows | Export-Csv -Path $configCsvPath -NoTypeInformation -Encoding UTF8
        }

        if ($PSCmdlet.ShouldProcess($readmePath, 'Write README output documentation file')) {
            Set-Content -Path $readmePath -Value $readmeContent -Encoding UTF8
        }


        Write-Host "Export completed."
        Write-Host "Info CSV:     $infoCsvPath"
        Write-Host "Settings CSV: $settingsCsvPath"
        Write-Host "Config CSV:   $configCsvPath"
        Write-Host "README File:  $readmePath"
        Write-Host "Started:      $($scriptStartTime.ToString('yyyy-MM-dd HH:mm:ss'))"
        Write-Host "Ended:        $($scriptEndTime.ToString('yyyy-MM-dd HH:mm:ss'))"
        Write-Host "Duration:     $($scriptDuration.ToString('hh\:mm\:ss'))"

        [PSCustomObject]@{
            FileBaseName        = $FileBaseName
            OutputFolder        = $OutputFolder
            InfoCsv             = $infoCsvPath
            SettingsCsv         = $settingsCsvPath
            ConfigCsv           = $configCsvPath
            ReadmeFile          = $readmePath
            StartTime           = $scriptStartTime
            EndTime             = $scriptEndTime
            Duration            = $scriptDuration.ToString('hh\:mm\:ss')
            ProcessedInstances  = $processedInstances.Count
            FailedInstances     = $failedInstances.Count
            FailedInstanceNames = if ($failedInstances.Count -gt 0) { $failedInstances -join '; ' } else { '' }
        }

    }
    catch {
        throw "Failed to export consolidated CSV files. $($_.Exception.Message)"
    }
}
